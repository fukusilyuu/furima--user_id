 <%= form_with model: @item, local: true do |f| %>
         <%= f.collection_select(:genre_id_eq, Genre.all, :id, :name, {}, {class:"select-box", id:"item-category"}) %>
         <%= f.collection_select(:quality_id_eq, Quality.all, :id, :name, {}, {class:"select-box", id:"item-sales-status"}) %>
         <%= f.collection_select(:payment_id_eq, Payment.all, :id, :name, {}, {class:"select-box", id:"item-shipping-fee-status"}) %>
         <%= f.collection_select(:days_id_eq, Days.all, :id, :name, {}, {class:"select-box", id:"item-scheduled-delivery"}) %>
         
         <%end%>
        