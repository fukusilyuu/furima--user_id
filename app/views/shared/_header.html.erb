<%# CSS・・・assets/stylesheets/shared/header.css %>
<script src="category.js?date=20250918"></script>
<header class='top-page-header'>
  <div class='search-bar-contents'>
    <div class="shared-header">
      <%= render "shared/header_header" %>
    </div>
      <%= link_to image_tag("images/furima-logo-color.png", class:"furima-icon"), "/" %>
   
    <form class="search-form" action="#">
      <%#se?fo?%>
     <%= form_with model: @item, url: search_items_path, local: true do |f| %>
      <%= f.text_field :name, class:'input-box', placeholder:'キーワードから探す'%>
        <div id="search-result"></div>
      <button class="search-button">

        <%= image_tag "images/search.png", class:"search-icon" %>
      </button>
     <%end%>
    </form>
  </div>
  <div class='nav'>
    <ul class='lists-left'>
       <%# search_form_for @q do |f| %>
       <%= search_form_for @q, url: search_items_path, html: {id: "detailed-search-form"} do |f| %>
     <li><%= link_to 'カテゴリー', "#", id:"categorys", class: "category-list", id:"category-del" %></li>
      
    </li>
      <li><%= link_to 'ブランド', "#", class: "brand-list", id:"category-del" %></li>
      <%end%>
    </ul>
    <ul class='lists-right'>
      <% if user_signed_in?%>
      <li><%= link_to current_user.nickname, "#", class: "user-nickname", id:"category-del" %></li> 
      <li><%= link_to 'ログアウト', "#", data: {turbo_method: :delete}, class: "logout", id:"category-del" %></li> 

<%else%>
      <li><%= link_to 'ログイン', new_user_session_path, class: "login", id:"category-del" %></li>
      <li><%= link_to '新規登録', "#", class: "sign-up", id:"category-del" %></li>
      <%end%>
    </ul>
  </div>
</header>